{
    "designSystem": {
      "name": "Modern Minimalist Landing Page System",
      "version": "1.0",
      "description": "Clean, organic design system with earth tones, generous whitespace, and nature-inspired imagery",
      
      "colorPalette": {
        "primary": {
          "olive": "#6B7A4F",
          "darkOlive": "#556542",
          "description": "Used for CTAs, accents, and brand elements"
        },
        "neutral": {
          "white": "#FFFFFF",
          "offWhite": "#FAFAFA",
          "lightBeige": "#E8E3D9",
          "warmBeige": "#D4C5A9",
          "softGray": "#F5F5F5",
          "mediumGray": "#666666",
          "darkGray": "#333333",
          "black": "#000000"
        },
        "semantic": {
          "background": "#FFFFFF",
          "text": "#000000",
          "textSecondary": "#666666",
          "accent": "#6B7A4F"
        }
      },
      
      "typography": {
        "fontFamilies": {
          "primary": "Serif typeface (Georgia, Playfair Display, or similar)",
          "secondary": "Sans-serif typeface (Inter, system-ui, or similar)"
        },
        "hierarchy": {
          "hero": {
            "fontSize": "72px-96px",
            "fontWeight": 400,
            "lineHeight": "1.1",
            "letterSpacing": "-0.02em",
            "fontFamily": "primary",
            "usage": "Main hero headlines"
          },
          "h1": {
            "fontSize": "48px-64px",
            "fontWeight": 400,
            "lineHeight": "1.2",
            "letterSpacing": "-0.01em",
            "fontFamily": "primary",
            "usage": "Section titles"
          },
          "h2": {
            "fontSize": "32px-40px",
            "fontWeight": 400,
            "lineHeight": "1.3",
            "fontFamily": "primary",
            "usage": "Subsection titles"
          },
          "h3": {
            "fontSize": "24px-28px",
            "fontWeight": 500,
            "lineHeight": "1.4",
            "fontFamily": "secondary",
            "usage": "Card titles, feature headers"
          },
          "body": {
            "fontSize": "16px-18px",
            "fontWeight": 400,
            "lineHeight": "1.6",
            "fontFamily": "secondary",
            "usage": "Body text, descriptions"
          },
          "small": {
            "fontSize": "14px",
            "fontWeight": 400,
            "lineHeight": "1.5",
            "fontFamily": "secondary",
            "usage": "Captions, labels"
          },
          "overline": {
            "fontSize": "12px-14px",
            "fontWeight": 600,
            "lineHeight": "1.4",
            "letterSpacing": "0.08em",
            "textTransform": "uppercase",
            "fontFamily": "secondary",
            "usage": "Section labels, tags"
          }
        }
      },
      
      "spacing": {
        "scale": "8px base unit",
        "sections": {
          "small": "80px-100px",
          "medium": "120px-160px",
          "large": "200px-240px"
        },
        "components": {
          "xs": "8px",
          "sm": "16px",
          "md": "24px",
          "lg": "32px",
          "xl": "48px",
          "2xl": "64px",
          "3xl": "96px"
        },
        "containerPadding": {
          "mobile": "20px",
          "tablet": "40px",
          "desktop": "80px-120px"
        }
      },
      
      "layout": {
        "maxWidth": "1440px",
        "contentMaxWidth": "1200px",
        "gridColumns": 12,
        "gridGap": "24px",
        "breakpoints": {
          "mobile": "320px",
          "tablet": "768px",
          "desktop": "1024px",
          "wide": "1440px"
        }
      },
      
      "components": {
        "buttons": {
          "primary": {
            "backgroundColor": "#6B7A4F",
            "color": "#FFFFFF",
            "padding": "14px 32px",
            "borderRadius": "24px",
            "fontSize": "14px",
            "fontWeight": 600,
            "textTransform": "uppercase",
            "letterSpacing": "0.05em",
            "border": "none",
            "hoverEffect": "Slight darken + subtle scale (1.02)",
            "transition": "all 0.2s ease"
          },
          "secondary": {
            "backgroundColor": "transparent",
            "color": "#000000",
            "padding": "14px 32px",
            "borderRadius": "24px",
            "fontSize": "14px",
            "fontWeight": 600,
            "border": "1px solid #000000",
            "hoverEffect": "Background to black, text to white"
          },
          "text": {
            "backgroundColor": "transparent",
            "color": "#6B7A4F",
            "padding": "8px 16px",
            "fontSize": "14px",
            "fontWeight": 600,
            "border": "none",
            "textDecoration": "underline",
            "hoverEffect": "Opacity 0.7"
          }
        },
        
        "cards": {
          "standard": {
            "backgroundColor": "#FFFFFF",
            "borderRadius": "0px",
            "padding": "0px",
            "boxShadow": "none",
            "border": "none",
            "overflow": "hidden"
          },
          "elevated": {
            "backgroundColor": "#FFFFFF",
            "borderRadius": "16px",
            "padding": "32px",
            "boxShadow": "0 4px 20px rgba(0,0,0,0.08)",
            "border": "1px solid #F0F0F0"
          }
        },
        
        "navigation": {
          "header": {
            "height": "80px",
            "backgroundColor": "transparent or white",
            "position": "fixed or sticky",
            "padding": "0 80px",
            "boxShadow": "0 1px 0 rgba(0,0,0,0.05)",
            "zIndex": 1000
          },
          "logo": {
            "fontSize": "18px-20px",
            "fontWeight": 600,
            "color": "#000000"
          },
          "links": {
            "fontSize": "14px",
            "fontWeight": 500,
            "color": "#000000",
            "spacing": "32px",
            "hoverEffect": "Color to olive"
          }
        },
        
        "imageContainers": {
          "hero": {
            "aspectRatio": "16:9 or 21:9",
            "borderRadius": "24px",
            "overflow": "hidden",
            "objectFit": "cover"
          },
          "feature": {
            "aspectRatio": "4:3 or 1:1",
            "borderRadius": "16px",
            "overflow": "hidden",
            "objectFit": "cover"
          },
          "full": {
            "aspectRatio": "Varies - full width",
            "borderRadius": "0px or 32px",
            "overflow": "hidden",
            "objectFit": "cover"
          }
        },
        
        "iconography": {
          "style": "Outline or minimal solid",
          "size": "20px-24px standard",
          "strokeWidth": "1.5px-2px",
          "color": "Matches text or olive accent"
        }
      },
      
      "sections": {
        "hero": {
          "structure": "Full-width, centered content",
          "alignment": "center",
          "textAlign": "center",
          "spacing": {
            "paddingTop": "120px-160px",
            "paddingBottom": "80px-120px"
          },
          "elements": [
            "Large hero headline (serif)",
            "Optional subheading",
            "Primary CTA button",
            "Hero image/visual below text",
            "Logo strip or social proof"
          ]
        },
        
        "featureGrid": {
          "structure": "2-4 column grid",
          "gap": "32px-48px",
          "alignment": "start",
          "cardStyle": "minimal, icon + text",
          "elements": [
            "Icon (top)",
            "Feature title",
            "Description text"
          ]
        },
        
        "splitContent": {
          "structure": "50/50 two-column layout",
          "gap": "64px-96px",
          "alignment": "center",
          "responsive": "Stack on mobile",
          "elements": [
            "Image on one side",
            "Text content on other",
            "Optional list items",
            "Optional CTA"
          ]
        },
        
        "testimonial": {
          "structure": "Centered or split layout",
          "maxWidth": "800px",
          "elements": [
            "Large quote text (serif)",
            "Attribution with name/title",
            "Optional company logo",
            "Optional image"
          ]
        },
        
        "numberedSteps": {
          "structure": "Horizontal row or grid",
          "gap": "48px-64px",
          "elements": [
            "Large number (serif, 48px+)",
            "Step title",
            "Description"
          ]
        },
        
        "cta": {
          "structure": "Centered, full-width",
          "backgroundColor": "White or light beige",
          "padding": "80px-120px",
          "elements": [
            "Headline",
            "Subheading",
            "Primary button"
          ]
        }
      },
      
      "designPrinciples": {
        "whitespace": "Generous spacing between all elements, breathing room is priority",
        "imagery": "High-quality, nature-inspired, landscape photography with organic textures",
        "minimalism": "Clean layouts, limited color palette, clear hierarchy",
        "typography": "Mix of elegant serif headlines with clean sans-serif body text",
        "interactions": "Subtle, smooth transitions and hover effects",
        "accessibility": "High contrast text, clear focus states, semantic HTML"
      },
      
      "animations": {
        "pageTransitions": {
          "duration": "0.3s-0.5s",
          "easing": "ease-in-out"
        },
        "hoverEffects": {
          "duration": "0.2s",
          "easing": "ease",
          "properties": ["opacity", "transform", "background-color"]
        },
        "scrollAnimations": {
          "type": "Fade in + slight translate up",
          "duration": "0.6s",
          "easing": "ease-out",
          "stagger": "0.1s between elements"
        }
      },
      
      "contentPatterns": {
        "headlines": {
          "style": "Short, punchy, benefit-driven",
          "examples": ["Browse everything.", "We've cracked the code.", "See the Big Picture"]
        },
        "descriptions": {
          "length": "1-2 sentences, concise",
          "tone": "Professional yet approachable"
        },
        "ctaText": {
          "style": "Action-oriented, uppercase, 1-3 words",
          "examples": ["Learn More", "Get Started", "Contact Us"]
        }
      },
      
      "imageGuidelines": {
        "subjects": ["Nature landscapes", "Abstract minimalist compositions", "Product photography with neutral backgrounds"],
        "colorGrading": "Natural, slightly warm tones, high contrast",
        "composition": "Rule of thirds, balanced, professional",
        "quality": "High resolution, sharp, well-lit",
        "avoid": "Stock photo look, overly saturated colors, busy backgrounds"
      },
      
      "responsiveDesign": {
        "mobile": {
          "fontSize": "Scale down 20-30%",
          "spacing": "Reduce by 40-50%",
          "layout": "Single column, stacked",
          "navigation": "Hamburger menu"
        },
        "tablet": {
          "fontSize": "Scale down 10-15%",
          "spacing": "Reduce by 20-30%",
          "layout": "2 columns for grids"
        },
        "desktop": {
          "fontSize": "Base sizes",
          "spacing": "Full spacing",
          "layout": "Multi-column layouts"
        }
      }
    }
  }